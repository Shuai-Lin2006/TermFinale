# 复制为 .env 并填入你自己的 Key（不要把真实 Key 提交到仓库）
# 开发期放项目根目录；打包版放用户数据目录：
#   macOS: ~/Library/Application Support/TermFinale/.env
#   Windows: %APPDATA%\TermFinale\.env

DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 可选：模型与性能
# DEEPSEEK_MODEL=deepseek-flash
# QWEN_VL_MODEL=qwen3.8-max
# DEEPSEEK_MAX_TOKENS=8192
# TERMFINALE_CONCURRENCY=2
# TERMFINALE_VISION_CONCURRENCY=4
# TERMFINALE_DISABLE_VISION=1
